+def allocate_cached_token_counts(
+    cached_tokens_details: CachedTokensDetails | None,
+    cache_read_tokens: int,
+) -> Mapping[str, int]:
+    """Split the aggregate cached-token count into the per-modality parts a provider reported.
+
+    Returns an empty mapping when no nested split was supplied, so a caller can keep its
+    existing aggregate-only billing. Parts are taken in order and capped at the aggregate
+    cached count, so a provider that over-reports the split can never make us bill more
+    cached tokens than it reported for the request. Never mutates the source details.
+    """
+    if cached_tokens_details is None:
+        return MappingProxyType({})
+    remaining: int = max(cache_read_tokens, 0)
+    allocation: dict[str, int] = {}
+    for field in _CACHED_MODALITY_FIELDS:
+        reported: Final = getattr(cached_tokens_details, field, None)
+        if not isinstance(reported, int) or reported <= 0:
+            continue
+        allocated: Final = min(reported, remaining)
+        if allocated:
+            allocation[field] = allocated
+            remaining -= allocated
+    return MappingProxyType(allocation)
 
 
