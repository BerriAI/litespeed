@@ -0,0 +1,253 @@
+"""Realtime cached audio input is billed at its own cache-read rate.
+
+The OpenAI Realtime API reports a per-modality split of the cached prompt tokens
+under ``input_token_details.cached_tokens_details``. That nested split used to be
+dropped during usage normalization, so the cost calculator billed every cached
+token at the text cache-read rate and double-billed the cached audio tokens inside
+the full-rate audio bucket.
+
+These tests pin the whole path: normalization preserves the nested split, the
+combine step sums it across ``response.done`` events, the calculator removes the
+cached tokens from their full-rate buckets and bills cached audio at
+``cache_read_input_audio_token_cost``, and the logged breakdown agrees.
+"""
+
+from typing import Final
+
+import pytest
+
+import litellm
+from litellm.cost_calculator import (
+    BaseTokenUsageProcessor,
+    RealtimeAPITokenUsageProcessor,
+    handle_realtime_stream_cost_calculation,
+)
+from litellm.litellm_core_utils.llm_cost_calc.utils import (
+    generic_cost_per_token,
+    get_token_type_cost_breakdown,
+)
+from litellm.responses.litellm_completion_transformation.transformation import (
+    LiteLLMCompletionResponsesConfig,
+)
+from litellm.responses.utils import ResponseAPILoggingUtils
+from litellm.types.utils import Usage
+
+
+@pytest.fixture(autouse=True)
+def _local_model_cost_map(monkeypatch: pytest.MonkeyPatch) -> None:
+    monkeypatch.setenv("LITELLM_LOCAL_MODEL_COST_MAP", "True")
+    monkeypatch.setattr(litellm, "model_cost", litellm.get_model_cost_map(url=""))
+    litellm.get_model_info.cache_clear()
+
+
+_TEXT_TOKENS: Final = 116
+_AUDIO_TOKENS: Final = 167
+_CACHED_TOKENS: Final = 192
+_CACHED_TEXT: Final = 64
+_CACHED_AUDIO: Final = 128
+
+
+def _raw_usage(with_nested_split: bool = True) -> dict:
+    input_token_details: Final = {
+        "text_tokens": _TEXT_TOKENS,
+        "audio_tokens": _AUDIO_TOKENS,
+        "cached_tokens": _CACHED_TOKENS,
+    }
+    if with_nested_split:
+        input_token_details["cached_tokens_details"] = {
+            "text_tokens": _CACHED_TEXT,
+            "audio_tokens": _CACHED_AUDIO,
+        }
+    return {
+        "input_tokens": _TEXT_TOKENS + _AUDIO_TOKENS,
+        "output_tokens": 0,
+        "total_tokens": _TEXT_TOKENS + _AUDIO_TOKENS,
+        "input_token_details": input_token_details,
+    }
+
+
+def test_realtime_cached_audio_input_charges_the_worked_example() -> None:
+    """116 text + 167 audio with 192 cached (64 text / 128 audio) bills 52 full-rate
+    text, 39 full-rate audio, and each cached bucket once at its own rate."""
+    results = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {"type": "response.done", "response": {"usage": _raw_usage()}},
+    ]
+
+    combined = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(
+        results=results
+    )
+    total_cost = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+
+    info = litellm.get_model_info(model="gpt-realtime")
+    assert info["cache_read_input_audio_token_cost"] == pytest.approx(4e-7)
+    expected = (
+        52 * info["input_cost_per_token"]
+        + 39 * info["input_cost_per_audio_token"]
+        + _CACHED_TEXT * info["cache_read_input_token_cost"]
+        + _CACHED_AUDIO * info["cache_read_input_audio_token_cost"]
+    )
+    assert total_cost == pytest.approx(expected)
+    assert total_cost == pytest.approx(0.0015328)
+
+
+def test_normalization_preserves_cached_tokens_details_and_converts_back() -> None:
+    """The nested split survives realtime/Responses normalization and the conversion
+    back to a Responses usage object."""
+    normalized = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(_raw_usage())
+
+    assert normalized.prompt_tokens_details is not None
+    cached_details = normalized.prompt_tokens_details.cached_tokens_details
+    assert cached_details is not None
+    assert cached_details.text_tokens == _CACHED_TEXT
+    assert cached_details.audio_tokens == _CACHED_AUDIO
+    # Full-rate buckets are untouched at normalization time; the calculator removes the
+    # cached tokens so the breakdown total still reconciles.
+    assert normalized.prompt_tokens_details.text_tokens == _TEXT_TOKENS
+    assert normalized.prompt_tokens_details.audio_tokens == _AUDIO_TOKENS
+
+    round_tripped = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(
+        normalized
+    )
+    assert round_tripped.input_tokens_details is not None
+    converted = round_tripped.input_tokens_details.cached_tokens_details
+    assert converted is not None
+    assert converted.text_tokens == _CACHED_TEXT
+    assert converted.audio_tokens == _CACHED_AUDIO
+
+
+def test_nested_key_is_omitted_from_serialized_usage_when_no_split_was_supplied() -> None:
+    """No nested split reported -> the key is absent, not null. Cache-write fields keep
+    their existing presence/absence behavior."""
+    without_split = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(
+        {
+            "input_tokens": 10,
+            "output_tokens": 1,
+            "total_tokens": 11,
+            "input_tokens_details": {"text_tokens": 5, "cached_tokens": 5, "cache_write_tokens": 7},
+        }
+    )
+    dumped = without_split.prompt_tokens_details.model_dump()
+    assert "cached_tokens_details" not in dumped
+    assert dumped["cache_write_tokens"] == 7
+
+    responses_side = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(
+        without_split
+    )
+    assert responses_side.input_tokens_details is not None
+    assert "cached_tokens_details" not in responses_side.input_tokens_details.model_dump()
+
+    no_write = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(
+        {
+            "input_tokens": 10,
+            "output_tokens": 1,
+            "total_tokens": 11,
+            "input_tokens_details": {"text_tokens": 5, "cached_tokens": 5},
+        }
+    )
+    dumped_no_write = no_write.prompt_tokens_details.model_dump()
+    assert "cache_write_tokens" not in dumped_no_write
+    assert "cached_tokens_details" not in dumped_no_write
+
+
+def test_combine_sums_nested_split_across_events_without_mutating_inputs() -> None:
+    """Only some response.done events carry the split; the combined usage sums what was
+    supplied and never mutates the per-event usage objects."""
+    first = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(_raw_usage())
+    second = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(_raw_usage(with_nested_split=False))
+
+    combined = BaseTokenUsageProcessor.combine_usage_objects([first, second])
+
+    assert combined.prompt_tokens_details is not None
+    combined_cached = combined.prompt_tokens_details.cached_tokens_details
+    assert combined_cached is not None
+    assert combined_cached.text_tokens == _CACHED_TEXT
+    assert combined_cached.audio_tokens == _CACHED_AUDIO
+    # The source usages are untouched and not aliased into the combined object.
+    assert first.prompt_tokens_details.cached_tokens_details is not combined_cached
+    assert first.prompt_tokens_details.cached_tokens_details.audio_tokens == _CACHED_AUDIO
+    assert getattr(second.prompt_tokens_details, "cached_tokens_details", None) is None
+
+
+def test_cached_audio_rate_falls_back_to_text_cache_read_rate() -> None:
+    """A model without ``cache_read_input_audio_token_cost`` bills cached audio at the
+    text cache-read rate, keeping prior billing."""
+    litellm.model_cost["probe-no-audio-cache-rate"] = {
+        "input_cost_per_token": 4e-6,
+        "output_cost_per_token": 1.6e-5,
+        "input_cost_per_audio_token": 3.2e-5,
+        "cache_read_input_token_cost": 4e-7,
+        "litellm_provider": "openai",
+        "mode": "realtime",
+    }
+    litellm.get_model_info.cache_clear()
+
+    usage = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(_raw_usage())
+    prompt_cost, _ = generic_cost_per_token(
+        model="probe-no-audio-cache-rate", usage=usage, custom_llm_provider="openai"
+    )
+
+    assert prompt_cost == pytest.approx(52 * 4e-6 + 39 * 3.2e-5 + _CACHED_TOKENS * 4e-7)
+
+    breakdown = get_token_type_cost_breakdown(
+        model="probe-no-audio-cache-rate", custom_llm_provider="openai", usage=usage
+    )
+    assert breakdown.cache_read_cost == pytest.approx(_CACHED_TOKENS * 4e-7)
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost is None
+
+
+def test_breakdown_agrees_with_input_billing_for_cached_audio() -> None:
+    """The logged cache-read line uses the audio rate for cached audio, so it reconciles
+    with the prompt cost the calculator charges."""
+    model: Final = "azure/gpt-realtime-mini"
+    provider: Final = "azure"
+    usage = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(_raw_usage())
+
+    prompt_cost, _ = generic_cost_per_token(model=model, usage=usage, custom_llm_provider=provider)
+    info = litellm.get_model_info(model=model, custom_llm_provider=provider)
+    breakdown = get_token_type_cost_breakdown(model=model, custom_llm_provider=provider, usage=usage)
+
+    expected_cache_read = (
+        _CACHED_TEXT * info["cache_read_input_token_cost"]
+        + _CACHED_AUDIO * info["cache_read_input_audio_token_cost"]
+    )
+    assert breakdown.cache_read_cost == pytest.approx(expected_cache_read)
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(
+        info["cache_read_input_audio_token_cost"]
+    )
+    expected_prompt_cost = (
+        52 * info["input_cost_per_token"]
+        + 39 * info["input_cost_per_audio_token"]
+        + expected_cache_read
+    )
+    assert prompt_cost == pytest.approx(expected_prompt_cost)
+
+
+def test_nested_allocation_is_capped_at_the_aggregate_cached_count() -> None:
+    """An over-reported split never bills more cached tokens than the aggregate count, and
+    removing cached tokens from a bucket never makes it negative."""
+    usage = Usage(
+        prompt_tokens=100,
+        completion_tokens=0,
+        total_tokens=100,
+        prompt_tokens_details={
+            "text_tokens": 10,
+            "audio_tokens": 90,
+            "cached_tokens": 50,
+            "cached_tokens_details": {"text_tokens": 40, "audio_tokens": 80},
+        },
+    )
+    prompt_cost, _ = generic_cost_per_token(
+        model="gpt-realtime", usage=usage, custom_llm_provider="openai"
+    )
+
+    # text: 40 cached (10 full-rate text clamped to 0); audio: only the remaining 10 of the
+    # 50 cached tokens, so 80 audio stays full-rate.
+    assert prompt_cost == pytest.approx(80 * 3.2e-5 + (40 + 10) * 4e-7)
