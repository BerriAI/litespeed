+def test_cached_audio_split_bills_and_reports_at_its_own_rate(_local_model_cost_map: None) -> None:
+    """A nested cached split prices cached audio at cache_read_input_audio_token_cost and the
+    itemized cache_read_cost agrees with the input line, while the full-rate buckets are net of it."""
+    model = "gpt-realtime"
+    usage = Usage(
+        prompt_tokens=283,
+        completion_tokens=0,
+        total_tokens=283,
+        prompt_tokens_details=PromptTokensDetailsWrapper(
+            text_tokens=116,
+            audio_tokens=167,
+            cached_tokens=192,
+            cached_tokens_details={"text_tokens": 64, "audio_tokens": 128},
+        ),
+    )
+
+    prompt_cost, _ = generic_cost_per_token(model=model, usage=usage, custom_llm_provider="openai")
+    breakdown = get_token_type_cost_breakdown(model=model, custom_llm_provider="openai", usage=usage)
+
+    info = litellm.get_model_info(model=model, custom_llm_provider="openai")
+    expected_cache_read = (
+        64 * info["cache_read_input_token_cost"] + 128 * info["cache_read_input_audio_token_cost"]
+    )
+    expected_full_rate = 52 * info["input_cost_per_token"] + 39 * info["input_cost_per_audio_token"]
+
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(4e-7)
+    assert breakdown.cache_read_cost == pytest.approx(expected_cache_read)
+    assert prompt_cost == pytest.approx(expected_full_rate + expected_cache_read)
+    assert prompt_cost == pytest.approx(0.0015328)
+
+
