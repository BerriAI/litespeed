+def _cached_token_allocation(usage: Usage, cache_hit_tokens: int) -> CachedTokenSplit:
+    """Optional per-modality split of the aggregate cache-read count.
+
+    Reads ``prompt_tokens_details.cached_tokens_details`` and caps the allocation at the
+    aggregate ``cache_hit_tokens`` so an over-reported split can never discount more
+    full-rate tokens than were actually cached. Absent details allocate nothing, keeping
+    the existing (unsplit) billing path unchanged.
+    """
+    empty: Final = CachedTokenSplit(text_tokens=0, audio_tokens=0, image_tokens=0)
+    if cache_hit_tokens <= 0 or usage.prompt_tokens_details is None:
+        return empty
+    details: Final = getattr(usage.prompt_tokens_details, "cached_tokens_details", None)
+    if details is None:
+        return empty
+    allocation: Final = CachedTokenSplit(text_tokens=0, audio_tokens=0, image_tokens=0)
+    remaining: Final = cache_hit_tokens
+    for modality in ("text_tokens", "audio_tokens", "image_tokens"):
+        allocated: Final = min(_cached_modality_token_count(details, modality), remaining)
+        allocation[modality] = allocated  # type: ignore[literal-required]
+        remaining -= allocated
+    return allocation
 
 
