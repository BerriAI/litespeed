+        completion_tokens=0,
+        total_tokens=200,
+        prompt_tokens_details=PromptTokensDetailsWrapper(
+            text_tokens=64,
+            audio_tokens=136,
+            cached_tokens=100,
+            cached_tokens_details={"text_tokens": 64, "audio_tokens": 128},
+        ),
+    )
+
+    prompt_cost, _ = generic_cost_per_token(model=model, usage=usage, custom_llm_provider="openai")
+    breakdown = get_token_type_cost_breakdown(model=model, custom_llm_provider="openai", usage=usage)
+
+    info = litellm.get_model_info(model=model, custom_llm_provider="openai")
+    # 64 cached text (of 100) + 36 cached audio; 100 full-rate audio remains, 0 full-rate text.
+    expected_cache_read = (
+        64 * info["cache_read_input_token_cost"] + 36 * info["cache_read_input_audio_token_cost"]
+    )
+    assert breakdown.cache_read_cost == pytest.approx(expected_cache_read)
+    assert prompt_cost == pytest.approx(100 * info["input_cost_per_audio_token"] + expected_cache_read)
