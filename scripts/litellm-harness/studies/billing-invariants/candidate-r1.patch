+def test_handle_realtime_stream_cost_calculation_bills_cached_audio_at_its_own_rate(
+    _local_model_cost_map: None,
+) -> None:
+    """Realtime cached audio bills at cache_read_input_audio_token_cost, and the nested cached
+    split is removed from the full-rate text/audio buckets so it is charged exactly once.
+
+    116 text + 167 audio input tokens with 192 cached (64 text / 128 audio) leaves 52 full-rate
+    text and 39 full-rate audio, plus the two cached buckets at their own rates.
+    """
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 283,
+                    "input_tokens": 283,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 167,
+                        "cached_tokens": 192,
+                        "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+                    },
+                }
+            },
+        },
+    ]
+    combined_usage_object = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(
+        results=results,
+    )
+
+    total_cost = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined_usage_object,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+
+    info = litellm.get_model_info(model="gpt-realtime", custom_llm_provider="openai")
+    assert info["cache_read_input_audio_token_cost"] == pytest.approx(4e-7)
+    expected = (
+        52 * info["input_cost_per_token"]
+        + 39 * info["input_cost_per_audio_token"]
+        + 64 * info["cache_read_input_token_cost"]
+        + 128 * info["cache_read_input_audio_token_cost"]
+    )
+    assert total_cost == pytest.approx(expected)
+    assert total_cost == pytest.approx(0.0015328)
+
+
+def test_combine_realtime_usage_sums_cached_tokens_details_without_mutating_sources() -> None:
+    """Only events that supply the split contribute, and the source usage objects are untouched."""
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 100,
+                    "input_tokens": 100,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 60,
+                        "audio_tokens": 40,
+                        "cached_tokens": 30,
+                        "cached_tokens_details": {"text_tokens": 10, "audio_tokens": 20},
+                    },
+                }
+            },
+        },
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 50,
+                    "input_tokens": 50,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 10,
+                        "audio_tokens": 40,
+                        "cached_tokens": 20,
+                    },
+                }
+            },
+        },
+    ]
+
+    collected = RealtimeAPITokenUsageProcessor.collect_usage_from_realtime_stream_results(results=results)
+
+    def _split_dump(usage: Usage) -> object:
+        split = getattr(usage.prompt_tokens_details, "cached_tokens_details", None)
+        return None if split is None else split.model_dump()
+
+    before = [_split_dump(u) for u in collected]
+
+    combined = RealtimeAPITokenUsageProcessor.combine_usage_objects(list(collected))
+
+    assert combined.prompt_tokens_details is not None
+    split = combined.prompt_tokens_details.cached_tokens_details
+    assert split is not None
+    assert split.text_tokens == 10
+    assert split.audio_tokens == 20
+    # The second event supplied no split, so it adds nothing.
+    assert combined.prompt_tokens_details.cached_tokens == 50
+    # Source usage objects must not be mutated by combining.
+    after = [_split_dump(u) for u in collected]
+    assert after == before
+
