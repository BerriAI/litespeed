diff --git a/tests/test_litellm/litellm_core_utils/llm_cost_calc/test_realtime_cached_audio_cost.py b/tests/test_litellm/litellm_core_utils/llm_cost_calc/test_realtime_cached_audio_cost.py
new file mode 100644
index 0000000..d67fff4
--- /dev/null
+++ b/tests/test_litellm/litellm_core_utils/llm_cost_calc/test_realtime_cached_audio_cost.py
@@ -0,0 +1,225 @@
+"""Cached audio input is billed at its own rate for Realtime/Responses usage.
+
+OpenAI's Realtime ``response.done`` events report the per-modality cached split
+under ``input_tokens_details.cached_tokens_details``. Dropping it billed every
+cached token at the text cache-read rate, overcharging cached audio. These tests
+cover the nested split surviving normalization and combination across events, the
+cost it produces, that the token-type breakdown agrees with it, and the fallback
+to the ordinary cache-read rate when a model publishes no audio cache rate.
+"""
+
+from collections.abc import Iterator
+
+import pytest
+
+import litellm
+from litellm.cost_calculator import RealtimeAPITokenUsageProcessor
+from litellm.litellm_core_utils.llm_cost_calc.utils import (
+    _get_token_base_cost,
+    generic_cost_per_token,
+    get_token_type_cost_breakdown,
+)
+from litellm.responses.litellm_completion_transformation.transformation import (
+    LiteLLMCompletionResponsesConfig,
+)
+from litellm.types.utils import Usage
+
+MODEL = "gpt-realtime"
+
+
+@pytest.fixture
+def local_model_cost_map(monkeypatch: pytest.MonkeyPatch) -> Iterator[None]:
+    monkeypatch.setenv("LITELLM_LOCAL_MODEL_COST_MAP", "True")
+    monkeypatch.setattr(litellm, "model_cost", litellm.get_model_cost_map(url=""))
+    litellm.get_model_info.cache_clear()
+    yield
+    litellm.get_model_info.cache_clear()
+
+
+def _response_done(input_tokens_details: dict) -> dict:
+    input_tokens = sum(
+        value for key, value in input_tokens_details.items() if key in ("text_tokens", "audio_tokens")
+    )
+    return {
+        "type": "response.done",
+        "response": {
+            "usage": {
+                "input_tokens": input_tokens,
+                "output_tokens": 0,
+                "total_tokens": input_tokens,
+                "input_tokens_details": input_tokens_details,
+            }
+        },
+    }
+
+
+def _combine(events: list[dict]) -> Usage:
+    return RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(events)
+
+
+def test_cached_audio_is_billed_at_the_audio_cache_rate(local_model_cost_map):
+    """116 text + 167 audio input tokens with 192 cached (64 text / 128 audio) costs 0.0015328."""
+    events = [
+        _response_done(
+            {
+                "text_tokens": 116,
+                "audio_tokens": 167,
+                "cached_tokens": 192,
+                "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+            }
+        )
+    ]
+    combined = _combine(events)
+
+    prompt_cost, _ = generic_cost_per_token(model=MODEL, usage=combined, custom_llm_provider="openai")
+
+    expected = (
+        52 * 0.000004  # full-rate text (116 - 64)
+        + 39 * 0.000032  # full-rate audio (167 - 128)
+        + 64 * 0.0000004  # cached text
+        + 128 * 0.0000004  # cached audio
+    )
+    assert prompt_cost == pytest.approx(expected)
+    assert prompt_cost == pytest.approx(0.0015328)
+
+
+def test_breakdown_agrees_with_input_billing_for_cached_audio(local_model_cost_map):
+    events = [
+        _response_done(
+            {
+                "text_tokens": 116,
+                "audio_tokens": 167,
+                "cached_tokens": 192,
+                "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+            }
+        )
+    ]
+    combined = _combine(events)
+
+    prompt_cost, _ = generic_cost_per_token(model=MODEL, usage=combined, custom_llm_provider="openai")
+    breakdown = get_token_type_cost_breakdown(model=MODEL, custom_llm_provider="openai", usage=combined)
+
+    assert breakdown.cache_read_cost == pytest.approx(192 * 0.0000004)
+    # input cost is the full prompt-side cost; cache_read_cost is an additive break-out of it
+    assert breakdown.cache_read_cost <= prompt_cost
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(
+        litellm.model_cost[MODEL]["cache_read_input_audio_token_cost"]
+    )
+
+
+def test_cached_split_combines_across_events_and_does_not_mutate_input(local_model_cost_map):
+    split = {"text_tokens": 64, "audio_tokens": 128}
+    events = [
+        _response_done(
+            {
+                "text_tokens": 116,
+                "audio_tokens": 167,
+                "cached_tokens": 192,
+                "cached_tokens_details": split,
+            }
+        ),
+        # This event carries no split at all and must contribute nothing to it.
+        _response_done({"text_tokens": 10, "audio_tokens": 4, "cached_tokens": 4}),
+        _response_done(
+            {
+                "text_tokens": 20,
+                "audio_tokens": 10,
+                "cached_tokens": 12,
+                "cached_tokens_details": {"audio_tokens": 12},
+            }
+        ),
+    ]
+
+    combined = _combine(events)
+    nested = combined.prompt_tokens_details.cached_tokens_details
+
+    assert nested.text_tokens == 64
+    assert nested.audio_tokens == 128 + 12
+
+    # The caller's event payloads are untouched.
+    assert events[0]["response"]["usage"]["input_tokens_details"]["cached_tokens_details"] == split
+
+
+def test_cached_split_is_absent_from_serialized_usage_when_never_supplied(local_model_cost_map):
+    combined = _combine([_response_done({"text_tokens": 10, "audio_tokens": 4, "cached_tokens": 4})])
+
+    dumped = combined.prompt_tokens_details.model_dump()
+    assert "cached_tokens_details" not in dumped
+
+
+def test_cached_split_round_trips_back_to_responses_usage(local_model_cost_map):
+    events = [
+        _response_done(
+            {
+                "text_tokens": 116,
+                "audio_tokens": 167,
+                "cached_tokens": 192,
+                "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+            }
+        )
+    ]
+    combined = _combine(events)
+
+    response_usage = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(combined)
+
+    assert response_usage.input_tokens_details.cached_tokens_details == {"text_tokens": 64, "audio_tokens": 128}
+
+
+def test_cached_audio_uses_its_own_rate_when_it_differs_from_text(local_model_cost_map):
+    """gpt-realtime-mini publishes 6e-8 for cached text but 3e-7 for cached audio."""
+    events = [
+        _response_done(
+            {
+                "text_tokens": 100,
+                "audio_tokens": 100,
+                "cached_tokens": 100,
+                "cached_tokens_details": {"text_tokens": 60, "audio_tokens": 40},
+            }
+        )
+    ]
+    combined = _combine(events)
+
+    prompt_cost, _ = generic_cost_per_token(model="gpt-realtime-mini", usage=combined, custom_llm_provider="openai")
+    breakdown = get_token_type_cost_breakdown(
+        model="gpt-realtime-mini", custom_llm_provider="openai", usage=combined
+    )
+
+    expected = (
+        40 * 0.0000006  # full-rate text
+        + 60 * 0.00001  # full-rate audio
+        + 60 * 0.00000006  # cached text
+        + 40 * 0.0000003  # cached audio
+    )
+    assert prompt_cost == pytest.approx(expected)
+    assert breakdown.cache_read_cost == pytest.approx(60 * 0.00000006 + 40 * 0.0000003)
+
+
+def test_cached_audio_falls_back_to_the_text_cache_rate_when_no_audio_rate(local_model_cost_map):
+    model_info = {"input_cost_per_token": 1e-6, "output_cost_per_token": 2e-6, "cache_read_input_token_cost": 1e-7}
+
+    *_, cache_read_cost, cache_read_audio_cost = _get_token_base_cost(model_info, Usage(prompt_tokens=10))
+
+    assert cache_read_audio_cost == pytest.approx(cache_read_cost)
+    assert cache_read_audio_cost == pytest.approx(1e-7)
+
+
+def test_cached_split_is_capped_at_the_aggregate_cached_count(local_model_cost_map):
+    """A split larger than the aggregate cached count cannot allocate more than it covers."""
+    events = [
+        _response_done(
+            {
+                "text_tokens": 100,
+                "audio_tokens": 100,
+                "cached_tokens": 10,
+                "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+            }
+        )
+    ]
+    combined = _combine(events)
+
+    prompt_cost, _ = generic_cost_per_token(model=MODEL, usage=combined, custom_llm_provider="openai")
+
+    # 10 cached text at the text cache rate; full-rate text 90, full-rate audio 100.
+    expected = 90 * 0.000004 + 100 * 0.000032 + 10 * 0.0000004
+    assert prompt_cost == pytest.approx(expected)
