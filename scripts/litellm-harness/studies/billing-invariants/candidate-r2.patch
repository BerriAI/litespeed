+def test_realtime_cached_audio_split_bills_full_rate_remainders_and_cached_buckets_once(
+    _local_model_cost_map: None,
+) -> None:
+    """Realtime response.done reports which modality the cached tokens came from: 116 text + 167 audio
+    input with 192 cached (64 text, 128 audio) must bill the 52/39 uncached remainder at full rate and
+    the cached buckets once each, audio at the audio cache-read rate."""
+    from litellm.litellm_core_utils.llm_cost_calc.utils import get_token_type_cost_breakdown
+
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 283,
+                    "input_tokens": 283,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 167,
+                        "cached_tokens": 192,
+                        "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+                    },
+                }
+            },
+        },
+    ]
+
+    combined_usage_object = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(
+        results=results,
+    )
+
+    assert combined_usage_object.prompt_tokens_details is not None
+    assert combined_usage_object.prompt_tokens_details.cached_tokens_details is not None
+    assert combined_usage_object.prompt_tokens_details.cached_tokens_details.text_tokens == 64
+    assert combined_usage_object.prompt_tokens_details.cached_tokens_details.audio_tokens == 128
+    # The caller's input usage is not mutated in place.
+    assert results[1]["response"]["usage"]["input_token_details"]["cached_tokens_details"] == {
+        "text_tokens": 64,
+        "audio_tokens": 128,
+    }
+
+    total_cost = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined_usage_object,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+
+    info = litellm.get_model_info(model="gpt-realtime", custom_llm_provider="openai")
+    assert info["cache_read_input_audio_token_cost"] == 4e-07
+    assert total_cost == pytest.approx(0.0015328)
+
+    breakdown = get_token_type_cost_breakdown(
+        model="gpt-realtime", custom_llm_provider="openai", usage=combined_usage_object
+    )
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == 4e-07
+    assert breakdown.cache_read_cost == pytest.approx(192 * 4e-07)
+
+
+def test_realtime_cached_audio_split_combines_across_events_when_some_omit_it(
+    _local_model_cost_map: None,
+) -> None:
+    """The nested cached split sums across response.done events; events that omit it still contribute
+    their aggregate cached count and are not billed twice."""
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 230,
+                    "input_tokens": 230,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 50,
+                        "cached_tokens": 64,
+                        "cached_tokens_details": {"audio_tokens": 64},
+                    },
+                }
+            },
+        },
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 150,
+                    "input_tokens": 150,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 100,
+                        "audio_tokens": 30,
+                        "cached_tokens": 20,
+                    },
+                }
+            },
+        },
+    ]
+
+    combined = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(results=results)
+
+    assert combined.prompt_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens == 84
+    assert combined.prompt_tokens_details.cached_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens_details.audio_tokens == 64
+
+    total_cost = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+    # 84 - 64 cached audio bills at the text cache rate; the rest is the uncached remainder.
+    assert total_cost == pytest.approx(216 * 4e-6 + 16 * 3.2e-5 + 64 * 4e-07 + 20 * 4e-07)
+
+
+def test_realtime_cached_split_capped_at_aggregate_cached_count_without_negative_buckets(
+    _local_model_cost_map: None,
+) -> None:
+    """A nested split larger than the aggregate cached count is capped, and the full-rate modality
+    buckets floor at zero rather than going negative."""
+    from litellm.litellm_core_utils.llm_cost_calc.utils import (
+        generic_cost_per_token,
+        parse_prompt_tokens_details,
+    )
+    from litellm.types.utils import PromptTokensDetailsWrapper, Usage
+
+    usage = Usage(
+        prompt_tokens=20,
+        completion_tokens=0,
+        total_tokens=20,
+        prompt_tokens_details=PromptTokensDetailsWrapper(
+            text_tokens=10,
+            audio_tokens=10,
+            cached_tokens=5,
+            cached_tokens_details={"text_tokens": 20, "audio_tokens": 20},
+        ),
+    )
+
+    details = parse_prompt_tokens_details(usage)
+    assert details["cache_hit_token_details"] is not None
+    assert details["cache_hit_token_details"].text_tokens == 5
+    assert details["cache_hit_token_details"].audio_tokens == 0
+
+    prompt_cost, _ = generic_cost_per_token(
+        model="gpt-realtime", usage=usage, custom_llm_provider="openai"
+    )
+    # text 10 - 5 = 5 full rate; audio 10 - 0 = 10 full rate; 5 cached text at the cache rate.
+    assert prompt_cost == pytest.approx(5 * 4e-6 + 10 * 3.2e-5 + 5 * 4e-07)
+
