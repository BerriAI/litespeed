+def test_realtime_cached_audio_input_bills_at_audio_cache_rate(_local_model_cost_map: None) -> None:
+    """Cached realtime audio bills at cache_read_input_audio_token_cost, not the text cache rate.
+
+    Regression: the nested ``cached_tokens_details`` split was dropped during realtime usage
+    normalization, so cached audio billed at the text cache-read rate (over-billing). The split is
+    also combined across response.done events and removed from the full-rate modality buckets.
+    """
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 283,
+                    "input_tokens": 283,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 167,
+                        "cached_tokens": 192,
+                        "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+                    },
+                    "output_token_details": {"text_tokens": 0, "audio_tokens": 0},
+                }
+            },
+        },
+        {  # a turn that supplies no split must not drop or reset the accumulated one
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "total_tokens": 0,
+                    "input_tokens": 0,
+                    "output_tokens": 0,
+                    "input_token_details": {"text_tokens": 0, "audio_tokens": 0, "cached_tokens": 0},
+                    "output_token_details": {"text_tokens": 0, "audio_tokens": 0},
+                }
+            },
+        },
+    ]
+
+    per_event_usage: Final = RealtimeAPITokenUsageProcessor.collect_usage_from_realtime_stream_results(results)
+    combined: Final = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(results)
+
+    assert combined.prompt_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens == 192
+    assert combined.prompt_tokens_details.cached_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens_details.text_tokens == 64
+    assert combined.prompt_tokens_details.cached_tokens_details.audio_tokens == 128
+    # combining must not mutate the per-event usage it read from
+    assert per_event_usage[0].prompt_tokens_details is not None
+    assert per_event_usage[0].prompt_tokens_details.cached_tokens_details is not None
+    assert per_event_usage[0].prompt_tokens_details.cached_tokens_details.audio_tokens == 128
+
+    total_cost: Final = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+
+    # 52 full-rate text + 39 full-rate audio + 64 cached text + 128 cached audio
+    assert total_cost == pytest.approx(0.0015328)
+
+    from litellm.litellm_core_utils.llm_cost_calc.utils import get_token_type_cost_breakdown
+
+    breakdown: Final = get_token_type_cost_breakdown(
+        model="gpt-realtime", custom_llm_provider="openai", usage=combined
+    )
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(4e-07)
+    assert breakdown.cache_read_cost == pytest.approx((64 + 128) * 4e-07)
+    # the audio cache rate is exposed through model-info lookups too
+    assert litellm.get_model_info("gpt-realtime")["cache_read_input_audio_token_cost"] == pytest.approx(4e-07)
+
+    # a model whose audio and text cache rates differ proves the split selects the audio rate
+    mini_breakdown: Final = get_token_type_cost_breakdown(
+        model="gpt-realtime-mini", custom_llm_provider="openai", usage=combined
+    )
+    assert mini_breakdown.rates is not None
+    assert mini_breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(3e-07)
+    assert mini_breakdown.cache_read_cost == pytest.approx(64 * 6e-08 + 128 * 3e-07)
+
+
