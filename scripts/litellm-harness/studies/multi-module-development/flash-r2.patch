+def test_realtime_cached_audio_split_is_preserved_and_billed():
+    """Realtime response.done reports ``cached_tokens_details`` alongside the cached total.
+
+    Dropping that nested split overbills cached audio: it is billed at the text cache-read
+    rate and is still counted in the full-rate audio bucket. The split must survive
+    normalization and be removed from the matching full-rate buckets.
+    """
+    from litellm.litellm_core_utils.llm_cost_calc.utils import get_token_type_cost_breakdown
+
+    provider_usage = {
+        "input_tokens": 283,
+        "output_tokens": 0,
+        "total_tokens": 283,
+        "input_token_details": {
+            "text_tokens": 116,
+            "audio_tokens": 167,
+            "cached_tokens": 192,
+            "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+        },
+    }
+    results: OpenAIRealtimeStreamList = [
+        {"type": "session.created", "session": {"model": "gpt-realtime"}},
+        {"type": "response.done", "response": {"usage": provider_usage}},
+    ]
+
+    combined = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(
+        results=results,
+    )
+
+    assert combined.prompt_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens == 192
+    assert combined.prompt_tokens_details.cached_tokens_details is not None
+    assert combined.prompt_tokens_details.cached_tokens_details.text_tokens == 64
+    assert combined.prompt_tokens_details.cached_tokens_details.audio_tokens == 128
+    # Normalization must not mutate the provider payload it was handed.
+    assert provider_usage["input_token_details"]["cached_tokens_details"] == {
+        "text_tokens": 64,
+        "audio_tokens": 128,
+    }
+
+    total_cost = handle_realtime_stream_cost_calculation(
+        results=results,
+        combined_usage_object=combined,
+        custom_llm_provider="openai",
+        litellm_model_name="gpt-realtime",
+    )
+
+    # 116-64=52 full-rate text, 167-128=39 full-rate audio, then the cached buckets once each.
+    expected_input_cost = 52 * 4e-6 + 39 * 3.2e-5 + 64 * 4e-7 + 128 * 4e-7
+    assert expected_input_cost == pytest.approx(0.0015328)
+    assert total_cost == pytest.approx(expected_input_cost)
+
+    # The reported cache-read line uses the audio rate for cached audio, so it agrees with billing.
+    breakdown = get_token_type_cost_breakdown(model="gpt-realtime", custom_llm_provider="openai", usage=combined)
+    assert breakdown.rates is not None
+    assert breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(4e-7)
+    assert breakdown.cache_read_cost == pytest.approx((64 + 128) * 4e-7)
+
+
