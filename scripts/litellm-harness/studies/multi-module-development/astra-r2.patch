+@pytest.mark.parametrize("splits", [(False, False), (True, False), (False, True), (True, True)])
+def test_realtime_combines_optional_cached_audio_split_without_mutation(splits: tuple[bool, bool]) -> None:
+    from litellm.responses.litellm_completion_transformation.transformation import LiteLLMCompletionResponsesConfig
+
+    results: Final = [
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "input_tokens": 283,
+                    "output_tokens": 0,
+                    "total_tokens": 283,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 167,
+                        "cached_tokens": 192,
+                        **(
+                            {"cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128, "image_tokens": 0}}
+                            if has_split
+                            else {}
+                        ),
+                    },
+                },
+            },
+        }
+        for has_split in splits
+    ]
+    before: Final = deepcopy(results)
+    usages: Final = RealtimeAPITokenUsageProcessor.collect_usage_from_realtime_stream_results(results)
+    usage_before: Final = [usage.model_dump() for usage in usages]
+    combined: Final = BaseTokenUsageProcessor.combine_usage_objects(usages)
+    details: Final = combined.model_dump()["prompt_tokens_details"]
+    assert combined.prompt_tokens == 566
+    assert details["cached_tokens"] == 384
+    assert "cache_write_tokens" not in details
+    assert "cache_creation_tokens" not in details
+    converted: Final = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(combined)
+    if any(splits):
+        assert details["cached_tokens_details"] == {
+            "text_tokens": 64 * sum(splits),
+            "audio_tokens": 128 * sum(splits),
+            "image_tokens": 0,
+        }
+        assert (
+            converted.model_dump()["input_tokens_details"]["cached_tokens_details"] == details["cached_tokens_details"]
+        )
+    else:
+        assert "cached_tokens_details" not in details
+        assert "cached_tokens_details" not in converted.model_dump()["input_tokens_details"]
+    assert [usage.model_dump() for usage in usages] == usage_before
+    assert results == before
+    if all(splits):
+        assert handle_realtime_stream_cost_calculation(
+            results,
+            combined,
+            "openai",
+            "gpt-realtime",
+        ) == pytest.approx(2 * 0.0015328)
