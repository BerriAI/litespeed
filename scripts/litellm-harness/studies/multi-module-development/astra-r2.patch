+@pytest.mark.parametrize("details_key", ["input_token_details", "input_tokens_details"])
+@pytest.mark.parametrize("cache_write", [None, 0, 7])
+def test_cached_audio_usage_round_trip_and_billing(details_key: str, cache_write: int | None) -> None:
+    from litellm.litellm_core_utils.llm_cost_calc.utils import get_token_type_cost_breakdown
+    from litellm.responses.litellm_completion_transformation.transformation import LiteLLMCompletionResponsesConfig
+    from litellm.responses.utils import ResponseAPILoggingUtils
+    from litellm.types.llms.openai import ResponseAPIUsage
+
+    split: Final = {"text_tokens": 64, "audio_tokens": 128, "image_tokens": 0}
+    raw: Final = {
+        "input_tokens": 283 + (cache_write or 0),
+        "output_tokens": 0,
+        "total_tokens": 283 + (cache_write or 0),
+        details_key: {
+            "text_tokens": 116,
+            "audio_tokens": 167,
+            "cached_tokens": 192,
+            "cached_tokens_details": split,
+            **({"cache_write_tokens": cache_write} if cache_write is not None else {}),
+        },
+    }
+    before: Final = deepcopy(raw)
+    normalized: Final = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(raw)
+    serialized: Final = normalized.model_dump()["prompt_tokens_details"]
+    assert serialized["cached_tokens_details"] == split
+    if cache_write is None:
+        assert "cache_write_tokens" not in serialized
+        assert "cache_creation_tokens" not in serialized
+    else:
+        assert serialized["cache_write_tokens"] == cache_write
+        assert serialized["cache_creation_tokens"] == cache_write
+    converted: Final = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(normalized)
+    assert converted.model_dump()["input_tokens_details"]["cached_tokens_details"] == split
+    assert ("cache_write_tokens" in converted.model_dump()["input_tokens_details"]) == (cache_write is not None)
+    from_object: Final = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(
+        ResponseAPIUsage(**converted.model_dump())
+    )
+    assert from_object.model_dump() == normalized.model_dump()
+    if cache_write is None:
+        cost: Final = cost_per_token(
+            model="gpt-realtime",
+            prompt_tokens=283,
+            completion_tokens=0,
+            usage_object=normalized,
+            custom_llm_provider="openai",
+        )
+        assert cost == pytest.approx((0.0015328, 0))
+        breakdown: Final = get_token_type_cost_breakdown("gpt-realtime", "openai", normalized)
+        assert breakdown.cache_read_cost == pytest.approx(192 * 0.0000004)
+        assert breakdown.rates.cache_read_input_audio_token_cost == 0.0000004
+    assert raw == before
