+def test_realtime_cached_audio_input_cost_and_breakdown(_local_model_cost_map):
+    from litellm.litellm_core_utils.llm_cost_calc.utils import get_token_type_cost_breakdown
+
+    events = [
+        {
+            "type": "response.done",
+            "response": {
+                "usage": {
+                    "input_tokens": 283,
+                    "output_tokens": 0,
+                    "input_token_details": {
+                        "text_tokens": 116,
+                        "audio_tokens": 167,
+                        "cached_tokens": 192,
+                        "cached_tokens_details": {"text_tokens": 64, "audio_tokens": 128},
+                    },
+                }
+            },
+        }
+    ]
+    usage = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(events)
+    cost = handle_realtime_stream_cost_calculation(events, usage, "openai", "gpt-realtime")
+    breakdown = get_token_type_cost_breakdown("gpt-realtime", "openai", usage)
+    assert cost == pytest.approx(0.0015328)
+    assert breakdown.cache_read_cost == pytest.approx(192 * 4e-7)
+    assert cost - breakdown.cache_read_cost == pytest.approx(52 * 4e-6 + 39 * 32e-6)
+    assert breakdown.rates.cache_read_input_audio_token_cost == 4e-7
+    assert litellm.get_model_info("gpt-realtime")["cache_read_input_audio_token_cost"] == 4e-7
