+    from litellm.responses.utils import ResponseAPILoggingUtils
+
+    split = {"text_tokens": 64, "audio_tokens": 128, "image_tokens": 3}
+    details = {
+        "text_tokens": 116,
+        "audio_tokens": 167,
+        "image_tokens": 3,
+        "cached_tokens": 195,
+        "cached_tokens_details": split,
+        **({"cache_write_tokens": cache_write_tokens} if cache_write_tokens is not None else {}),
+    }
+    raw = {"input_tokens": 286, "output_tokens": 0, "total_tokens": 286, details_key: details}
+    original = deepcopy(raw)
+    usage = ResponseAPILoggingUtils._transform_response_api_usage_to_chat_usage(raw)
+    serialized = usage.model_dump()["prompt_tokens_details"]
+    assert serialized["cached_tokens_details"] == split
+    restored = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(usage)
+    restored_details = restored.model_dump()["input_tokens_details"]
+    assert restored_details["cached_tokens_details"] == split
+    assert restored_details["image_tokens"] == 3
+    if cache_write_tokens is None:
+        assert "cache_write_tokens" not in serialized
+        assert "cache_creation_tokens" not in serialized
+        assert "cache_write_tokens" not in restored_details
+    else:
+        assert serialized["cache_write_tokens"] == cache_write_tokens
+        assert serialized["cache_creation_tokens"] == cache_write_tokens
+        assert restored_details["cache_write_tokens"] == cache_write_tokens
+
+    unsplit = {
+        "input_tokens": 10,
+        "output_tokens": 0,
+        "total_tokens": 10,
+        "input_token_details": {"text_tokens": 10, "cached_tokens": 2},
+    }
+    events = [{"type": "response.done", "response": {"usage": item}} for item in (unsplit, raw, raw, unsplit)]
+    events_before = deepcopy(events)
+    combined = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results(events)
+    assert combined.prompt_tokens_details.cached_tokens == 394
+    assert combined.model_dump()["prompt_tokens_details"]["cached_tokens_details"] == {
+        "text_tokens": 128,
+        "audio_tokens": 256,
+        "image_tokens": 6,
+    }
+    assert events == events_before
+    assert raw == original
+    assert usage.model_dump()["prompt_tokens_details"]["cached_tokens_details"] == split
+
+    no_split = RealtimeAPITokenUsageProcessor.collect_and_combine_usage_from_realtime_stream_results([events[0]])
+    assert "cached_tokens_details" not in no_split.model_dump()["prompt_tokens_details"]
+    assert "cache_write_tokens" not in no_split.model_dump()["prompt_tokens_details"]
+    no_split_restored = LiteLLMCompletionResponsesConfig._transform_chat_completion_usage_to_responses_usage(no_split)
+    assert "cached_tokens_details" not in no_split_restored.model_dump()["input_tokens_details"]
+
