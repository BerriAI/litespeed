+@pytest.mark.parametrize("audio_cache_rate", [None, 0.0, 4e-7])
+@pytest.mark.parametrize(
+    "split, expected_full, expected_cached_audio",
+    [
+        (None, (0, 95, 0), 0),
+        ({"text_tokens": 64, "audio_tokens": 128, "image_tokens": 10}, (52, 39, 4), 128),
+        ({"text_tokens": 64, "audio_tokens": 128}, (52, 39, 4), 128),
+        ({"text_tokens": 60, "audio_tokens": 128, "image_tokens": 4}, (56, 39, 0), 128),
+        ({"audio_tokens": 999}, (91, 0, 4), 192),
+        ({"text_tokens": -10, "audio_tokens": 128, "image_tokens": 64}, (56, 39, 0), 128),
+    ],
+)
+def test_cached_modality_allocation_is_capped_and_rates_match(
+    monkeypatch,
+    audio_cache_rate,
+    split,
+    expected_full,
+    expected_cached_audio,
+):
+    from litellm.litellm_core_utils.llm_cost_calc.utils import generic_cost_per_token, get_token_type_cost_breakdown
+
+    info = {
+        "input_cost_per_token": 4e-6,
+        "input_cost_per_audio_token": 32e-6,
+        "input_cost_per_image_token": 5e-6,
+        "output_cost_per_token": 16e-6,
+        "cache_read_input_token_cost": 1e-7,
+        "cache_read_input_audio_token_cost": audio_cache_rate,
+        "input_cost_per_token_priority": 8e-6,
+        "cache_read_input_token_cost_priority": 2e-7,
+        "regional_processing_uplift_multiplier_eu": 1.1,
+        "litellm_provider": "openai",
+        "mode": "realtime",
+    }
+    model = f"cached-modality-test-{audio_cache_rate}"
+    monkeypatch.setitem(litellm.model_cost, model, info)
+    usage = Usage(
+        prompt_tokens=287,
+        prompt_tokens_details={
+            "text_tokens": 116,
+            "audio_tokens": 167,
+            "image_tokens": 4,
+            "cached_tokens": 192,
+            **({"cached_tokens_details": split} if split is not None else {}),
+        },
+    )
+    before = usage.model_dump()
+    cost, _ = generic_cost_per_token(model, usage, "openai")
+    breakdown = get_token_type_cost_breakdown(model, "openai", usage)
+    rate = 1e-7 if audio_cache_rate is None else audio_cache_rate
+    expected_cache = (192 - expected_cached_audio) * 1e-7 + expected_cached_audio * rate
+    text, audio, image = expected_full
+    assert cost == pytest.approx(text * 4e-6 + audio * 32e-6 + image * 5e-6 + expected_cache)
+    assert breakdown.cache_read_cost == pytest.approx(expected_cache)
+    assert breakdown.rates.cache_read_input_audio_token_cost == rate
+    assert usage.model_dump() == before
+
+    regional_cost, _ = generic_cost_per_token(
+        model,
+        usage,
+        "openai",
+        service_tier="priority",
+        data_residency="eu",
+    )
+    regional_breakdown = get_token_type_cost_breakdown(
+        model,
+        "openai",
+        usage,
+        service_tier="priority",
+        data_residency="eu",
+    )
+    priority_audio_cache_rate = 2e-7 if audio_cache_rate is None else audio_cache_rate
+    priority_cache = (192 - expected_cached_audio) * 2e-7 + expected_cached_audio * priority_audio_cache_rate
+    assert regional_cost == pytest.approx((text * 8e-6 + audio * 32e-6 + image * 5e-6 + priority_cache) * 1.1)
+    assert regional_breakdown.cache_read_cost == pytest.approx(priority_cache * 1.1)
+    assert regional_breakdown.rates.cache_read_input_audio_token_cost == pytest.approx(priority_audio_cache_rate * 1.1)
+
+    custom = {"input_cost_per_token": 2e-6, "output_cost_per_token": 3e-6, "cache_read_input_token_cost": 5e-7}
+    custom_breakdown = get_token_type_cost_breakdown(
+        model,
+        "openai",
+        usage,
+        custom_cost_per_token=custom,
+    )
+    assert custom_breakdown.cache_read_cost == pytest.approx(192 * 5e-7)
+
+
 @pytest.fixture
