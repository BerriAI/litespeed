diff --git a/tests/project-guidance.test.ts b/tests/project-guidance.test.ts
new file mode 100644
index 0000000..3014c79
--- /dev/null
+++ b/tests/project-guidance.test.ts
@@ -0,0 +1,47 @@
+import { afterEach, beforeEach, expect, it } from 'vitest';
+import { mkdtemp, writeFile, rm, symlink, link } from 'node:fs/promises';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { captureProjectGuidance } from '../server/tools.js';
+
+let root:string;
+beforeEach(async()=>{root=await mkdtemp(join(tmpdir(),'referenced-guidance-'));});
+afterEach(async()=>{await rm(root,{recursive:true,force:true});});
+
+it('captures the explicitly referenced root file only when requested',async()=>{
+  await writeFile(join(root,'AGENTS.md'),'Read @CLAUDE.md for coding guidelines\n');
+  await writeFile(join(root,'CLAUDE.md'),'Use Final and do not rebind local variables.');
+  expect(captureProjectGuidance(root)).not.toContain('Use Final');
+  const captured=captureProjectGuidance(root,{referencedClaude:true});
+  expect(captured).toContain('Project instructions (CLAUDE.md):\nUse Final');
+  await writeFile(join(root,'CLAUDE.md'),'Later instructions');
+  expect(captured).not.toContain('Later instructions');
+});
+
+it.each(['CLAUDE.md exists here.','Do not read CLAUDE.md.','Read /tmp/CLAUDE.md','Read nested/CLAUDE.md','Read @OTHER.md','Read CLAUDE.md.bak','Read CLAUDE.md/nested'])('does not follow unrelated or external mentions: %s',async(instruction)=>{
+  await writeFile(join(root,'AGENTS.md'),instruction);
+  await writeFile(join(root,'CLAUDE.md'),'DO_NOT_CAPTURE');
+  expect(captureProjectGuidance(root,{referencedClaude:true})).not.toContain('DO_NOT_CAPTURE');
+});
+
+it('bounds the referenced file and does not follow another reference',async()=>{
+  await writeFile(join(root,'AGENTS.md'),'Read CLAUDE.md');
+  await writeFile(join(root,'CLAUDE.md'),'Read @OTHER.md\n'+'x'.repeat(24000)+'OMITTED_TAIL');
+  await writeFile(join(root,'OTHER.md'),'DO_NOT_CAPTURE');
+  const captured=captureProjectGuidance(root,{referencedClaude:true});
+  expect(captured).toContain('Read @OTHER.md');
+  expect(captured).not.toContain('DO_NOT_CAPTURE');
+  expect(captured).not.toContain('OMITTED_TAIL');
+});
+
+it.each(['symlink','hardlink','oversized','binary','invalid-utf8'] as const)('skips an unsafe referenced file: %s',async(kind)=>{
+  await writeFile(join(root,'AGENTS.md'),'Read @CLAUDE.md');
+  const target=join(root,'CLAUDE.md');
+  if(kind==='symlink'||kind==='hardlink'){
+    const source=join(root,'source');await writeFile(source,'DO_NOT_CAPTURE');
+    if(kind==='symlink')await symlink(source,target);else await link(source,target);
+  }else await writeFile(target,kind==='oversized'?'x'.repeat(300000):kind==='binary'?'DO_NOT_CAPTURE\0':Buffer.from([0xff]));
+  const captured=captureProjectGuidance(root,{referencedClaude:true});
+  expect(captured).toContain('Project instructions (AGENTS.md)');
+  expect(captured).not.toContain('Project instructions (CLAUDE.md)');
+});
