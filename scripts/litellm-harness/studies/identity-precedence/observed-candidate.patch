+# Session headers the proxy accepts. When the proxy derives ``litellm_trace_id``
+# from one of these, the id identifies the *session*, not an individual call, so
+# Langfuse must not upsert every call of the session onto one trace.
+_GENERIC_SESSION_ID_HEADER_RE: Final = re.compile(r"^x-.+-session-id$", re.IGNORECASE)
+_BARE_SESSION_ID_HEADER: Final = "x-session-id"
+_EXPLICIT_TRACE_ID_HEADERS: Final = ("x-litellm-trace-id", "langfuse_trace_id")
+# Codex sends its conversation uuid in unprefixed headers (see
+# ``litellm/proxy/litellm_pre_call_utils.py``).
+_CODEX_SESSION_ID_HEADERS: Final = ("session-id", "session_id", "thread-id", "conversation_id")
+_CODEX_CLIENT_PREFIX_RE: Final = re.compile(r"^codex[-_ /]", re.IGNORECASE)
+# Session-id values must be non-empty strings of alphanumerics, hyphens, or underscores.
+_SESSION_ID_VALUE_RE: Final = re.compile(r"^[a-zA-Z0-9_\-]{8,}$")
+
+
+def _is_codex_user_agent(user_agent: object) -> bool:
+    """True when ``user_agent`` belongs to a first-party Codex client."""
+    return isinstance(user_agent, str) and bool(_CODEX_CLIENT_PREFIX_RE.match(user_agent))
+
+
+def _is_session_alias_trace_id(trace_id: object, litellm_params: object) -> bool:
+    """
+    Return True when ``trace_id`` is merely an alias for the request's session.
+
+    The proxy copies a client-supplied session header (``x-litellm-session-id``,
+    a vendor ``x-<vendor>-session-id``, or Codex's unprefixed session headers)
+    into ``litellm_trace_id``. Logging that value as the Langfuse trace id would
+    upsert every call in the session onto a single trace, so callers must split
+    per call instead.
+
+    A trace id is only treated as an alias when a recognised session header
+    carries *exactly* that value. An explicit trace id (``x-litellm-trace-id`` /
+    ``langfuse_trace_id``) always wins and is never rewritten.
+    """
+    if not isinstance(trace_id, str) or not trace_id:
+        return False
+    if not isinstance(litellm_params, dict):
+        return False
+    proxy_server_request = litellm_params.get("proxy_server_request")
+    if not isinstance(proxy_server_request, dict):
+        return False
+    headers = proxy_server_request.get("headers")
+    if not isinstance(headers, dict):
+        return False
+
+    normalized: Final = {
+        key.lower(): value for key, value in headers.items() if isinstance(key, str)
+    }
+    if any(header in normalized for header in _EXPLICIT_TRACE_ID_HEADERS):
+        return False
+
+    is_codex: Final = _is_codex_user_agent(normalized.get("user-agent"))
+    for header_name, value in normalized.items():
+        if value != trace_id:
+            continue
+        if header_name == "x-litellm-session-id":
+            return True
+        if not _SESSION_ID_VALUE_RE.match(value):
+            continue
+        if header_name == _BARE_SESSION_ID_HEADER or _GENERIC_SESSION_ID_HEADER_RE.match(header_name):
+            return True
+        if is_codex and header_name in _CODEX_SESSION_ID_HEADERS:
+            return True
+    return False
+
 
