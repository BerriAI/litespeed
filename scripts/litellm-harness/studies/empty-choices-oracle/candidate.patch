+def _validated_choices_field(response_object: dict) -> list:
+    """
+    Return the response's ``choices`` list after validating its shape.
+
+    An explicit empty list is a valid upstream response: OpenAI-compatible
+    providers (vLLM, OpenAI with ``stream_options.include_usage``) emit
+    usage-only responses and metadata-only chunks with ``choices: []``. A
+    missing ``choices`` key or a value that is not a list (including ``None``)
+    is malformed and raises ``APIError`` with a diagnostic naming ``choices``
+    and the supplied type.
+    """
+    from litellm.exceptions import APIError
+
+    if "choices" not in response_object:
+        raise APIError(
+            status_code=500,
+            message=(
+                "LiteLLM: provider returned a response with no 'choices'. "
+                f"Raw keys: {list(response_object.keys())}"
+            ),
+            llm_provider="",
+            model="",
+        )
+
+    choices = response_object["choices"]
+    if not isinstance(choices, list):
+        raise APIError(
+            status_code=500,
+            message=(
+                "LiteLLM: provider returned a response with an invalid 'choices' field - expected a list. "
+                f"choices={choices!r}, type={type(choices).__name__}. "
+                f"Raw keys: {list(response_object.keys())}"
+            ),
+            llm_provider="",
+            model="",
+        )
+    return choices
+
+
