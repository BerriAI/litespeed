+def _team_info_prisma(team_row: LiteLLM_TeamTable, org_row: LiteLLM_OrganizationTable | None) -> MagicMock:
+    mock_prisma = MagicMock()
+    mock_prisma.db.litellm_teamtable.find_unique = AsyncMock(return_value=team_row)
+    mock_prisma.db.litellm_organizationtable.find_unique = AsyncMock(return_value=org_row)
+    mock_prisma.db.litellm_usertable.find_many = AsyncMock(return_value=[])
+    mock_prisma.get_data = AsyncMock(return_value=[])
+    return mock_prisma
+
+
+def _organization(models: list[str]) -> LiteLLM_OrganizationTable:
+    return LiteLLM_OrganizationTable(
+        organization_id="org-1",
+        organization_alias="Org One",
+        models=models,
+        budget_id="budget-1",
+        created_by="admin",
+        updated_by="admin",
+    )
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "caller, org_admin, expected",
+    [
+        (UserAPIKeyAuth(user_role=LitellmUserRoles.PROXY_ADMIN), False, ["gpt-4o", "all-proxy-models"]),
+        (UserAPIKeyAuth(user_role=LitellmUserRoles.PROXY_ADMIN_VIEW_ONLY), False, ["gpt-4o", "all-proxy-models"]),
+        (UserAPIKeyAuth(user_id="team-admin"), False, ["gpt-4o", "all-proxy-models"]),
+        (UserAPIKeyAuth(user_id="org-admin"), True, ["gpt-4o", "all-proxy-models"]),
+        (UserAPIKeyAuth(user_id="ordinary-member"), False, None),
+        (UserAPIKeyAuth(team_id="team-1", user_id=None), False, None),
+    ],
+)
+async def test_team_info_exposes_organization_models_only_to_admins(caller, org_admin, expected):
+    """``team_info.organization_models`` carries the parent org's allowlist for proxy
+    admins, team admins, and org admins, and is null for ordinary members and team keys.
+    """
+    from fastapi import Request
+
+    from litellm.proxy.management_endpoints import team_endpoints
+
+    team_row = LiteLLM_TeamTable(
+        team_id="team-1",
+        organization_id="org-1",
+        members_with_roles=[
+            Member(user_id="team-admin", role="admin"),
+            Member(user_id="ordinary-member", role="user"),
+        ],
+    )
+    mock_prisma = _team_info_prisma(team_row, _organization(["gpt-4o", "all-proxy-models"]))
+
+    with (
+        patch("litellm.proxy.proxy_server.prisma_client", mock_prisma),
+        patch.object(team_endpoints, "get_all_team_memberships", AsyncMock(return_value=[])),
+        patch.object(team_endpoints, "_is_user_org_admin_for_team", AsyncMock(return_value=org_admin)),
+    ):
+        response = await team_endpoints.team_info(
+            http_request=MagicMock(spec=Request),
+            team_id="team-1",
+            user_api_key_dict=caller,
+        )
+
+    assert response["team_info"].organization_models == expected
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("org_models", [[], ["all-proxy-models"]])
+async def test_team_info_preserves_configured_organization_model_sentinel(org_models):
+    """An empty allowlist and the all-proxy-models sentinel must be returned verbatim,
+    not collapsed to null or expanded.
+    """
+    from fastapi import Request
+
+    from litellm.proxy.management_endpoints import team_endpoints
+
+    team_row = LiteLLM_TeamTable(team_id="team-1", organization_id="org-1")
+    mock_prisma = _team_info_prisma(team_row, _organization(org_models))
+
+    with (
+        patch("litellm.proxy.proxy_server.prisma_client", mock_prisma),
+        patch.object(team_endpoints, "get_all_team_memberships", AsyncMock(return_value=[])),
+    ):
+        response = await team_endpoints.team_info(
+            http_request=MagicMock(spec=Request),
+            team_id="team-1",
+            user_api_key_dict=UserAPIKeyAuth(user_role=LitellmUserRoles.PROXY_ADMIN),
+        )
+
+    assert response["team_info"].organization_models == org_models
+
+
+@pytest.mark.asyncio
+async def test_team_info_organization_models_null_without_parent_organization():
+    """A standalone team has no parent org, so organization_models stays null and no
+    org lookup is issued.
+    """
+    from fastapi import Request
+
+    from litellm.proxy.management_endpoints import team_endpoints
