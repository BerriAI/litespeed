+@pytest.mark.asyncio
+@pytest.mark.parametrize("configured_models", [[], ["all-proxy-models"], ["gpt-4", "claude-3"]])
+async def test_team_info_organization_models_preserved_as_configured(configured_models):
+    """The configured org allowlist is returned unchanged, including an empty
+    list (distinct from null) and the all-proxy-models sentinel."""
+    team_row = LiteLLM_TeamTable(team_id="team-1", organization_id="org-1")
+    caller = UserAPIKeyAuth(user_role=LitellmUserRoles.PROXY_ADMIN)
+
+    response, _ = await _run_team_info(team_row, caller, org_row=_org_row(configured_models))
+
+    assert response["team_info"].organization_models == configured_models
