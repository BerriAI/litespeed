+async def _resolve_team_organization_models(
+    team_obj: LiteLLM_TeamTable,
+    user_api_key_dict: UserAPIKeyAuth,
+    prisma_client: PrismaClient,
+) -> list[str] | None:
+    """Return the parent organization's model allowlist for a team, or ``None``.
+
+    Only proxy admins, admins of the team, and admins of the team's parent
+    organization may see the org allowlist, so team managers can configure the
+    team's model access without calling ``/organization/info``. Ordinary members
+    and team keys get ``None``, as does a team with no organization. The stored
+    value is returned unchanged, preserving an empty list or the
+    ``all-proxy-models`` sentinel as configured.
+    """
+    if not team_obj.organization_id:
+        return None
+
+    can_view: Final = (
+        _user_has_admin_view(user_api_key_dict)
+        or _is_user_team_admin(user_api_key_dict=user_api_key_dict, team_obj=team_obj)
+        or await _is_user_org_admin_for_team(user_api_key_dict=user_api_key_dict, team_obj=team_obj)
+    )
+    if not can_view:
+        return None
+
+    organization_row: Final = await _org_db(prisma_client).find_unique(
+        where={"organization_id": team_obj.organization_id}
+    )
+    if organization_row is None:
+        return None
+
+    organization_obj: Final = LiteLLM_OrganizationTable.model_validate(organization_row.model_dump())
+    return list(organization_obj.models)
+
+
