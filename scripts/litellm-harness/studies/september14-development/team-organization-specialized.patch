+def _org_row(models):
+    """Prisma-shaped organization row whose only interesting column is ``models``."""
+    row = MagicMock()
+    row.model_dump.return_value = {
+        "organization_id": "org-1",
+        "organization_alias": "org-one",
+        "budget_id": "budget-1",
+        "created_by": "admin",
+        "updated_by": "admin",
+        "models": models,
+    }
+    return row
+
+
+async def _run_team_info(team_row, caller, org_row=None, org_admin_returns=False):
+    """Drive ``team_info`` with a mocked prisma client and return (response, client)."""
+    from fastapi import Request
+
+    from litellm.proxy.management_endpoints import team_endpoints
+
+    mock_prisma = MagicMock()
+    mock_prisma.db.litellm_teamtable.find_unique = AsyncMock(return_value=team_row)
+    mock_prisma.db.litellm_organizationtable.find_unique = AsyncMock(return_value=org_row)
+    mock_prisma.get_data = AsyncMock(return_value=[])
+
+    with (
+        patch("litellm.proxy.proxy_server.prisma_client", mock_prisma),
+        patch.object(team_endpoints, "get_all_team_memberships", AsyncMock(return_value=[])),
+        patch.object(team_endpoints, "UserRepository") as repo,
+        patch.object(
+            team_endpoints,
+            "_is_user_org_admin_for_team",
+            AsyncMock(return_value=org_admin_returns),
+        ),
+    ):
+        repo.return_value.table.find_many = AsyncMock(return_value=[])
+        response = await team_endpoints.team_info(
+            http_request=MagicMock(spec=Request),
+            team_id=team_row.team_id,
+            user_api_key_dict=caller,
+        )
+
+    return response, mock_prisma
+
+
+@pytest.mark.asyncio
+async def test_team_info_returns_organization_models_for_team_admin():
+    """/team/info must expose the parent org's model allowlist to a team admin so
+    they can configure team model access without calling /organization/info."""
+    team_row = LiteLLM_TeamTable(
+        team_id="team-1",
+        organization_id="org-1",
+        members_with_roles=[Member(user_id="team-admin", role="admin")],
+    )
+    caller = UserAPIKeyAuth(user_role=LitellmUserRoles.INTERNAL_USER, user_id="team-admin")
+
+    response, mock_prisma = await _run_team_info(team_row, caller, org_row=_org_row(["gpt-4", "all-proxy-models"]))
+
+    assert response["team_info"].organization_models == ["gpt-4", "all-proxy-models"]
+    mock_prisma.db.litellm_organizationtable.find_unique.assert_awaited_once()
+
+
+@pytest.mark.asyncio
+async def test_team_info_returns_organization_models_for_org_admin():
+    """An admin of the team's parent organization may also see the allowlist."""
+    team_row = LiteLLM_TeamTable(
+        team_id="team-1",
+        organization_id="org-1",
+        members_with_roles=[Member(user_id="someone-else", role="user")],
+    )
+    caller = UserAPIKeyAuth(user_role=LitellmUserRoles.INTERNAL_USER, user_id="org-admin")
+
+    response, _ = await _run_team_info(
+        team_row,
+        caller,
+        org_row=_org_row(["gpt-4"]),
+        org_admin_returns=True,
+    )
+
+    assert response["team_info"].organization_models == ["gpt-4"]
+
+
+@pytest.mark.asyncio
+async def test_team_info_organization_models_null_for_ordinary_member():
+    """Ordinary team members keep full team info but must not receive the org
+    allowlist, and the org table must not even be queried for them."""
+    team_row = LiteLLM_TeamTable(
+        team_id="team-1",
+        organization_id="org-1",
+        members_with_roles=[Member(user_id="member", role="user")],
+    )
+    caller = UserAPIKeyAuth(user_role=LitellmUserRoles.INTERNAL_USER, user_id="member")
+
+    response, mock_prisma = await _run_team_info(team_row, caller, org_row=_org_row(["gpt-4"]))
+
+    assert response["team_info"].organization_models is None
+    assert response["team_info"].team_id == "team-1"
+    mock_prisma.db.litellm_organizationtable.find_unique.assert_not_awaited()
+
+
