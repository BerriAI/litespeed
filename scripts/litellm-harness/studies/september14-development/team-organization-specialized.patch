+    caller = UserAPIKeyAuth(user_role=LitellmUserRoles.PROXY_ADMIN)
+
+    response, mock_prisma = await _run_team_info(team_row, caller, org_row=_org_row(["gpt-4"]))
+
+    assert response["team_info"].organization_models is None
+    mock_prisma.db.litellm_organizationtable.find_unique.assert_not_awaited()
+
