+def test_logging_init_skips_correlation_stamping_when_request_correlation_disabled(
+    monkeypatch: pytest.MonkeyPatch,
+):
+    """With litellm.request_correlation_in_logs off (the default) nothing reads
+    trace_id_var/session_id_var, so Logging.__init__() must not stamp them - and
+    must not pay set_trace_id()/set_session_id()'s control-char stripping and
+    credential redaction cost on every Logging object created."""
+    import litellm._logging as litellm_logging_module
+    from litellm.litellm_core_utils.litellm_logging import Logging
+
+    monkeypatch.setattr(litellm, "request_correlation_in_logs", False)
+    sanitize_calls: list[str] = []
+    monkeypatch.setattr(
+        litellm_logging_module,
+        "_sanitize_correlation_id",
+        lambda value: sanitize_calls.append(value) or value,
+    )
+    trace_id_var.set("")
+    session_id_var.set("")
+
+    log_obj = Logging(
+        model="gpt-3.5-turbo",
+        messages=[{"role": "user", "content": "hi"}],
+        stream=False,
+        call_type="completion",
+        start_time=None,
+        litellm_call_id="call-disabled",
+        function_id="fn-disabled",
+        litellm_trace_id="caller-trace",
+        kwargs={"litellm_session_id": "caller-session"},
+    )
+
+    assert sanitize_calls == []
+    assert trace_id_var.get() == ""
+    assert session_id_var.get() == ""
+    # Only the ambient contextvar stamping is gated - the plain attributes the
+    # StandardLoggingPayload reads stay populated as usual.
+    assert log_obj.litellm_trace_id == "caller-trace"
+    assert log_obj.litellm_session_id == "caller-session"
+    assert log_obj._correlation_logging_enabled is False
+
+
