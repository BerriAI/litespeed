+def _assembled_model_response(text: str):
+    from litellm.types.utils import Choices, Message, ModelResponse
+
+    return ModelResponse(
+        id="chatcmpl-legacy",
+        choices=[Choices(index=0, message=Message(content=text, role="assistant"), finish_reason="stop")],
+        model="m",
+    )
