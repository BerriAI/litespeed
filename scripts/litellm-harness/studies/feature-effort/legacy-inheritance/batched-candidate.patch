+class _LegacyHookTranslation:
+    """Models the contract the endpoint translations expose: the assembled OpenAI
+    response is handed to the target under request_data["response"], and the native
+    response is scanned back through process_output_response."""
+
+    delivers_ended_stream_text_rewrites = True
+
+    def __init__(self, assembled):
+        self.assembled = assembled
+
+    def post_call_hook_response(self, response):
+        return {"texts": [response.choices[0].message.content]}
+
+    async def process_output_streaming_response(
+        self,
+        responses_so_far,
+        guardrail_to_apply,
+        litellm_logging_obj=None,
+        user_api_key_dict=None,
+        request_data=None,
+        deliver_ended_stream_rewrites=False,
+    ):
+        request_data["response"] = self.assembled
+        scanned = responses_so_far[0]["text"]
+        outputs = await guardrail_to_apply.apply_guardrail(
+            inputs={"texts": [scanned]},
+            request_data=request_data,
+            input_type="response",
+            logging_obj=litellm_logging_obj,
+        )
+        if deliver_ended_stream_rewrites and outputs["texts"] and outputs["texts"][0] != scanned:
+            responses_so_far[0]["text"] = outputs["texts"][0]
+        return responses_so_far
+
+    async def process_output_response(
+        self, response, guardrail_to_apply, litellm_logging_obj=None, user_api_key_dict=None, request_data=None
+    ):
+        await guardrail_to_apply.apply_guardrail(
+            inputs={"texts": list(response["texts"])},
+            request_data=request_data or {},
+            input_type="response",
+            logging_obj=litellm_logging_obj,
+        )
+        return response
+
+
+class _LegacyHookGuardrail(CustomGuardrail):
+    """Overrides only the legacy post-call success hook, and keeps native lifecycle
+    hooks on, so it is eligible without unified apply_guardrail support."""
+
+    use_native_lifecycle_hooks = True
+
+    def __init__(self, hook):
+        super().__init__(guardrail_name="legacy", event_hook="post_call", default_on=True)
+        self.hook = hook
+        self.calls = []
+
+    async def async_post_call_success_hook(self, data, user_api_key_dict, response):
+        self.calls.append(response)
+        return self.hook(response)
+
+
+async def _run_legacy_step(guardrail, translation, chunks):
+    return await PipelineExecutor.execute_steps(
+        steps=[PipelineStep(guardrail="legacy", on_pass="allow", on_fail="block", on_error="next")],
+        mode="post_call",
+        data={"model": "m"},
+        user_api_key_dict=MagicMock(),
+        call_type="completion",
+        policy_name="p",
+        streaming_chunks=chunks,
+        endpoint_translation=translation,
+    )
+
