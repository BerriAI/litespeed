+class _GuardrailInputsCollector:
+    """No-op guardrail used to read back the texts an endpoint translation extracts
+    from a response, so a legacy hook's replacement can be compared against the
+    text the streaming scan already saw."""
+
+    def __init__(self) -> None:
+        self.texts: list[str] | None = None
+
+    async def apply_guardrail(
+        self,
+        inputs: GenericGuardrailAPIInputs,
+        request_data: dict,  # mutable-ok: matches CustomGuardrail.apply_guardrail
+        input_type: Literal["request", "response"],
+        logging_obj: object = None,
+    ) -> GenericGuardrailAPIInputs:
+        self.texts = [text for text in (inputs.get("texts") or [])]
+        return inputs
+
+
+class _LegacyStreamRewriteTarget(CustomGuardrail):
+    """Stand-in handed to the endpoint translation in place of a streaming pipeline
+    step's legacy guardrail. The translation assembles the buffered stream and calls
+    ``apply_guardrail``; this target invokes the guardrail's own
+    ``async_post_call_success_hook`` once with the standard data and the assembled
+    response in the endpoint's native non-streaming shape, then reports the
+    replacement's text back so the translation can write it across the buffered
+    chunks. A replacement whose text cannot be mapped one-to-one onto the scanned
+    text (a tool-call-only rewrite, a different number of text pieces) is
+    undeliverable and the executor releases the original chunks."""
+
+    def __init__(
+        self,
+        inner: CustomGuardrail,
+        endpoint_translation: "BaseTranslation",
+        user_api_key_dict: "UserAPIKeyAuth | None",
+        data: dict,  # mutable-ok: same request-payload shape the hook mutates
+        litellm_logging_obj: "LiteLLMLoggingObj | None",
+    ) -> None:
+        super().__init__(guardrail_name=inner.guardrail_name)
+        self.inner: Final = inner
+        self.endpoint_translation: Final = endpoint_translation
+        self.user_api_key_dict: Final = user_api_key_dict
+        self.data: Final = data
+        self.litellm_logging_obj: Final = litellm_logging_obj
+        self.rewrote = False
+
+    def structured_messages_cover_full_request(self) -> bool:
+        return self.inner.structured_messages_cover_full_request()
+
+    @_logged_by_inner_guardrail
+    async def apply_guardrail(
+        self,
+        inputs: GenericGuardrailAPIInputs,
+        request_data: dict,  # mutable-ok: matches CustomGuardrail.apply_guardrail
+        input_type: Literal["request", "response"],
+        logging_obj: "LiteLLMLoggingObj | None" = None,
+    ) -> GenericGuardrailAPIInputs:
+        replacement: Final = await self.inner.async_post_call_success_hook(
+            user_api_key_dict=self.user_api_key_dict,
+            data=self.data,
+            response=self.endpoint_translation.post_call_hook_response(request_data.get("response")),
+        )
+        if replacement is None:
+            return inputs
+        rewritten: Final = await self._replacement_texts(replacement)
+        scanned: Final = list(inputs.get("texts") or [])
+        if rewritten is None or len(rewritten) != len(scanned):
+            raise UndeliverableStreamRewrite(self.guardrail_name or "unknown")
+        if rewritten != scanned:
+            self.rewrote = True
+        return {**inputs, "texts": rewritten}
+
+    async def _replacement_texts(self, replacement: object) -> list[str] | None:
+        """Rescan the hook's native replacement through the same endpoint translation
+        to read the text pieces it now carries."""
+        collector: Final = _GuardrailInputsCollector()
+        await self.endpoint_translation.process_output_response(
+            response=replacement,
+            guardrail_to_apply=collector,
+            litellm_logging_obj=self.litellm_logging_obj,
+            user_api_key_dict=self.user_api_key_dict,
+        )
+        return collector.texts
+
