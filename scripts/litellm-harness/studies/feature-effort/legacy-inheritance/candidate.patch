+class _LegacyPostCallStreamGuardrail(CustomGuardrail):
+    """Stand-in handed to the endpoint translation in place of a streaming pipeline
+    step's guardrail when that guardrail keeps its own legacy
+    ``async_post_call_success_hook`` (instead of the unified ``apply_guardrail``
+    interface).
+
+    The translation scans the buffered stream, assembles an OpenAI ``ModelResponse``
+    and calls this adapter's ``apply_guardrail``. It converts the assembled response
+    to the endpoint's native non-streaming shape (``post_call_hook_response``), runs
+    the guardrail's legacy hook once, and rescans a returned replacement through the
+    same translation. A replacement whose texts do not line up one-to-one with what
+    the stream scanned cannot be delivered; the adapter leaves the transcription
+    untouched and reports ``discarded`` so the executor restores the original chunks
+    and warns. A rewrite on a translation without ended-stream write-back is reported
+    via ``rewrote`` for the same treatment. The inner hook records its own guardrail
+    information, so this adapter's ``apply_guardrail`` stays out of
+    ``log_guardrail_information``."""
+
+    def __init__(
+        self,
+        inner: CustomGuardrail,
+        endpoint_translation: "BaseTranslation",
+        user_api_key_dict: "UserAPIKeyAuth | None",
+    ) -> None:
+        super().__init__(guardrail_name=inner.guardrail_name)
+        self.inner: Final = inner
+        self.endpoint_translation: Final = endpoint_translation
+        self.user_api_key_dict: Final = user_api_key_dict
+        self.rewrote = False
+        self.discarded = False
+
+    @_logged_by_inner_guardrail
+    async def apply_guardrail(
+        self,
+        inputs: GenericGuardrailAPIInputs,
+        request_data: dict,  # mutable-ok: same request-payload shape the legacy hook mutates
+        input_type: Literal["request", "response"],
+        logging_obj: "LiteLLMLoggingObj | None" = None,
+    ) -> GenericGuardrailAPIInputs:
+        assembled: Final = request_data.get("response", request_data.get("responses"))
+        native: Final = self.endpoint_translation.post_call_hook_response(assembled)
+        replacement: Final = await self.inner.async_post_call_success_hook(
+            user_api_key_dict=self.user_api_key_dict,
+            data=request_data,
+            response=native,
+        )
+        if replacement is None:
+            return inputs
+
+        capture: Final = _ResponseTextCapture()
+        await self.endpoint_translation.process_output_response(
+            response=replacement,
+            guardrail_to_apply=capture,
+            litellm_logging_obj=logging_obj,
+            user_api_key_dict=self.user_api_key_dict,
+            request_data=None,
+        )
+        replacement_texts: Final = capture.texts
+        original_texts: Final = list(inputs.get("texts") or [])
+        if replacement_texts is None or len(replacement_texts) != len(original_texts):
+            self.discarded = True
+            return inputs
+        self.rewrote = self.rewrote or _text_inputs_changed(original_texts, replacement_texts)
+        return {**inputs, "texts": replacement_texts}  # mutable-ok: guardrail input contract is a plain dict
+
