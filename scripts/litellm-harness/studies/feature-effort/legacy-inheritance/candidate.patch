+def _legacy_hook_guardrail(guardrail_name: str, hook: Callable[..., Any]) -> CustomGuardrail:
+    class LegacyHookGuardrail(CustomGuardrail):
+        async def async_post_call_success_hook(self, user_api_key_dict, data, response):
+            return await hook(user_api_key_dict=user_api_key_dict, data=data, response=response)
+
+    return LegacyHookGuardrail(guardrail_name=guardrail_name, event_hook=GuardrailEventHooks.post_call, default_on=True)
