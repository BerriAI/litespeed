+# ---------------------------------------------------------------------------
+# legacy async_post_call_success_hook guardrails as streaming pipeline steps
+# ---------------------------------------------------------------------------
+
+
+class _LegacyPostCallGuardrail(CustomGuardrail):
+    """Keeps its own legacy post-call success hook, not the unified apply_guardrail."""
+
+    def __init__(self, replacement):
+        super().__init__(guardrail_name="legacy", event_hook="post_call", default_on=True)
+        self.replacement = replacement
+        self.calls = 0
+        self.seen_native = None
+
+    async def async_post_call_success_hook(self, user_api_key_dict, data, response):
+        self.calls += 1
+        self.seen_native = response
+        return self.replacement(response)
+
+
+class _LegacyTranslation:
+    """Fake endpoint translation whose native assembled shape is ``{"text": ...}``."""
+
+    delivers_ended_stream_text_rewrites = True
+
+    def post_call_hook_response(self, response):
+        return {"text": response["assembled_text"]}
+
+    async def process_output_response(
+        self, response, guardrail_to_apply, litellm_logging_obj=None, user_api_key_dict=None, request_data=None
+    ):
+        await guardrail_to_apply.apply_guardrail(
+            inputs={"texts": [response["text"]]},
+            request_data=request_data or {},
+            input_type="response",
+            logging_obj=litellm_logging_obj,
+        )
+        return response
+
+    async def process_output_streaming_response(
+        self,
+        responses_so_far,
+        guardrail_to_apply,
+        litellm_logging_obj=None,
+        user_api_key_dict=None,
+        request_data=None,
+        deliver_ended_stream_rewrites=False,
+        **kwargs,
+    ):
+        if request_data is None:
+            request_data = {}
+        request_data["response"] = {"assembled_text": responses_so_far[0]["text"]}
+        outputs = await guardrail_to_apply.apply_guardrail(
+            inputs={"texts": [responses_so_far[0]["text"]]},
+            request_data=request_data,
+            input_type="response",
+            logging_obj=litellm_logging_obj,
+        )
+        texts = outputs.get("texts") or []
+        if deliver_ended_stream_rewrites and texts and texts[0] != responses_so_far[0]["text"]:
+            responses_so_far[0]["text"] = texts[0]
+        return responses_so_far
+
+
+def _legacy_chunk():
+    return {"text": "hello world"}
+
+
+async def _run_legacy_streaming_step(translation=None):
+    chunks = [_legacy_chunk()]
+    result = await PipelineExecutor.execute_steps(
+        steps=[PipelineStep(guardrail="legacy", on_pass="allow", on_fail="block", on_error="next")],
+        mode="post_call",
+        data={"model": "m"},
+        user_api_key_dict=MagicMock(),
+        call_type="completion",
+        policy_name="p",
+        streaming_chunks=chunks,
+        endpoint_translation=translation or _LegacyTranslation(),
+    )
+    return result, chunks
+
