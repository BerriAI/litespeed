diff --git a/shared/file-edits.ts b/shared/file-edits.ts
new file mode 100644
index 0000000..f52a791
--- /dev/null
+++ b/shared/file-edits.ts
@@ -0,0 +1,35 @@
+/** Pure edit calculation shared by execution and the approval preview. */
+export function fileEndings(value:string,before:string):string {
+  const ending=before.match(/\r\n|\n|\r/)?.[0];
+  return ending?value.replace(/\r\n|\n|\r/g,ending):value;
+}
+
+export function applyFileEdits(before:string,args:Record<string,unknown>,allowBatch=false,maxBytes=2*1024*1024):{after:string;replacements:number} {
+  let edits:Record<string,unknown>[]=[args];
+  if(args.edits!==undefined) {
+    if(!allowBatch)throw new Error('Batched edits are available only in the LiteLLM-specific architecture.');
+    if(['old_string','new_string','replace_all'].some(key=>args[key]!==undefined))throw new Error('Use either edits or one old_string/new_string replacement, not both.');
+    if(!Array.isArray(args.edits)||!args.edits.length||args.edits.length>32)throw new Error('Supply 1–32 edits for one file.');
+    edits=args.edits.map(value=>{
+      if(!value||typeof value!=='object'||Array.isArray(value)||Object.keys(value).some(key=>!['old_string','new_string','replace_all'].includes(key)))throw new Error('Each edit supports only old_string, new_string and optional replace_all.');
+      return value as Record<string,unknown>;
+    });
+  }
+  let after=before,replacements=0;
+  for(const item of edits) {
+    if(typeof item.old_string!=='string'||!item.old_string.length)throw new Error('old_string must be a non-empty string.');
+    if(typeof item.new_string!=='string')throw new Error('new_string must be a string.');
+    const replaceAll=item.replace_all??false;
+    if(typeof replaceAll!=='boolean')throw new Error('replace_all must be a boolean.');
+    const oldString=fileEndings(item.old_string,after),newString=fileEndings(item.new_string,after);
+    const index=after.indexOf(oldString);
+    if(index<0)throw new Error('old_string was not found. Read the current file and provide an exact match. No content was written.');
+    if(!replaceAll&&after.indexOf(oldString,index+1)>=0)throw new Error('old_string matches more than once. Include more context or set replace_all to true. No content was written.');
+    if(replaceAll) {
+      const parts=after.split(oldString);replacements+=parts.length-1;after=parts.join(newString);
+    } else {replacements++;after=after.slice(0,index)+newString+after.slice(index+oldString.length);}
+    if(new TextEncoder().encode(after).byteLength>maxBytes)throw new Error(`Content is too large (maximum ${maxBytes} bytes). No content was written.`);
+    if(after.includes('\0'))throw new Error('Binary content is not supported. No content was written.');
+  }
+  return {after,replacements};
+}
