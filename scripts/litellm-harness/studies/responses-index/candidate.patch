+def _guardrail_tool_call_shapes(tool_calls: object) -> tuple[_ToolCallShape, ...]:
+    """Shapes for the tool calls a guardrail returned, dropping malformed entries.
+
+    A guardrail echoes the tool calls it was handed, so a missing "name" or
+    "arguments" key (as opposed to an explicit ``None`` name, which a custom
+    tool call without a name legitimately carries) means the entry cannot be
+    attributed back to a scanned call. Those entries are dropped so the caller
+    can compare the surviving count against what it scanned.
+    """
+    if not isinstance(tool_calls, Sequence) or isinstance(tool_calls, (str, bytes)):
+        return ()
+    shapes: list[_ToolCallShape] = []
+    for tool_call in tool_calls:
+        if not isinstance(tool_call, Mapping):
+            continue
+        function: Final = tool_call.get("function")
+        if not isinstance(function, Mapping) or "name" not in function or "arguments" not in function:
+            continue
+        name: Final = function.get("name")
+        arguments: Final = function.get("arguments")
+        if not isinstance(arguments, str) or (name is not None and not isinstance(name, str)):
+            continue
+        shapes.append(_ToolCallShape(name=name, arguments=arguments))
+    return tuple(shapes)
+
+
+def _tool_call_payload_field(item: object) -> str | None:
+    """The output-item payload field ("arguments" / "input") for a tool call item."""
+    item_type: Final = stream_item_field(item, "type")
+    return _TOOL_CALL_PAYLOAD_FIELD.get(item_type) if isinstance(item_type, str) else None
+
