+class TestOpenAIResponsesHandlerCustomToolCallScanKey:
+    """``get_streaming_scan_key`` treats custom tool calls as tool calls"""
+
+    @staticmethod
+    def _completed(output: List[Any]) -> dict:
+        return {"type": "response.completed", "sequence_number": 1, "response": {"output": output}}
+
+    def test_completed_event_with_a_custom_tool_call_changes_the_key(self):
+        handler = OpenAIResponsesHandler()
+        before = _custom_tool_call_item("patch one")
+        after = _custom_tool_call_item("patch two")
+
+        key_before = handler.get_streaming_scan_key([self._completed([before])])
+        key_after = handler.get_streaming_scan_key([self._completed([after])])
+
+        assert key_before.texts == ()
+        assert len(key_before.tool_calls) == 1
+        assert key_before != key_after
+
+    def test_custom_tool_call_item_is_not_read_as_message_text(self):
+        handler = OpenAIResponsesHandler()
+        key = handler.get_streaming_scan_key([self._completed([_custom_tool_call_item("patch")])])
+        assert key.texts == ()
