+class TestOpenAIResponsesHandlerCustomToolCallStreaming:
+    """ended-stream delivery syncs ``custom_tool_call_input.*`` events"""
+
+    @staticmethod
+    def _ended_custom_stream_events() -> List[dict]:
+        return [
+            {
+                "type": "response.output_item.added",
+                "sequence_number": 0,
+                "output_index": 0,
+                "item": _custom_tool_call_item("", "in_progress"),
+            },
+            {
+                "type": "response.custom_tool_call_input.delta",
+                "sequence_number": 1,
+                "item_id": "ctc_123",
+                "output_index": 0,
+                "delta": "patch ",
+            },
+            {
+                "type": "response.custom_tool_call_input.delta",
+                "sequence_number": 2,
+                "item_id": "ctc_123",
+                "output_index": 0,
+                "delta": "Secret",
+            },
+            {
+                "type": "response.custom_tool_call_input.done",
+                "sequence_number": 3,
+                "item_id": "ctc_123",
+                "output_index": 0,
+                "input": "patch Secret",
+            },
+            {
+                "type": "response.output_item.done",
+                "sequence_number": 4,
+                "output_index": 0,
+                "item": _custom_tool_call_item("patch Secret"),
+            },
+            {
+                "type": "response.completed",
+                "sequence_number": 5,
+                "response": {
+                    "id": "resp_123",
+                    "created_at": 1,
+                    "model": "gpt-4o",
+                    "output": [_custom_tool_call_item("patch Secret")],
+                    "status": "completed",
+                },
+            },
+        ]
+
+    @pytest.mark.asyncio
+    async def test_deliver_ended_stream_rewrites_syncs_custom_tool_call_events(self):
+        handler = OpenAIResponsesHandler()
+        events = self._ended_custom_stream_events()
+
+        result = await handler.process_output_streaming_response(
+            responses_so_far=events,
+            guardrail_to_apply=MaskToolCallArgumentsGuardrail(guardrail_name="mask"),
+            litellm_logging_obj=None,
+            deliver_ended_stream_rewrites=True,
+        )
+
+        assert result is events
+        assert events[0]["item"]["input"] == ""
+        assert events[1]["delta"] == "patch [MASKED]"
+        assert events[2]["delta"] == ""
+        assert events[3]["input"] == "patch [MASKED]"
+        assert events[4]["item"]["input"] == "patch [MASKED]"
+        assert events[5]["response"]["output"][0]["input"] == "patch [MASKED]"
+        assert events[5]["response"]["output"][0]["name"] == "apply_patch"
+
+    @pytest.mark.asyncio
+    async def test_deliver_ended_stream_rewrites_syncs_typed_custom_tool_call_events(self):
+        from openai.types.responses import (
+            ResponseCustomToolCallInputDeltaEvent,
+            ResponseCustomToolCallInputDoneEvent,
+        )
+
+        from litellm.types.llms.openai import (
+            OutputItemAddedEvent,
+            OutputItemDoneEvent,
+            ResponseCompletedEvent,
+        )
+
+        handler = OpenAIResponsesHandler()
+        typed_events: List[Any] = [
+            model.model_validate(event)
+            for model, event in zip(
+                (
+                    OutputItemAddedEvent,
+                    ResponseCustomToolCallInputDeltaEvent,
+                    ResponseCustomToolCallInputDeltaEvent,
+                    ResponseCustomToolCallInputDoneEvent,
+                    OutputItemDoneEvent,
+                    ResponseCompletedEvent,
+                ),
+                self._ended_custom_stream_events(),
+            )
+        ]
+
+        await handler.process_output_streaming_response(
+            responses_so_far=typed_events,
+            guardrail_to_apply=MaskToolCallArgumentsGuardrail(guardrail_name="mask"),
+            litellm_logging_obj=None,
+            deliver_ended_stream_rewrites=True,
+        )
+
+        assert typed_events[1].delta == "patch [MASKED]"
+        assert typed_events[2].delta == ""
+        assert typed_events[3].input == "patch [MASKED]"
+        assert typed_events[4].item.input == "patch [MASKED]"
+        assert typed_events[5].response.output[0].input == "patch [MASKED]"
+
+    @pytest.mark.asyncio
+    async def test_deliver_ended_stream_custom_rewrite_without_matching_events_fails_closed(self):
+        from litellm.proxy.policy_engine.pipeline_executor import UndeliverableStreamRewrite
+
+        handler = OpenAIResponsesHandler()
+        events = self._ended_custom_stream_events()
+        envelope_item = events[5]["response"]["output"][0]
+        events[5]["response"]["output"] = [{**envelope_item, "call_id": "call_999"}]
+
+        with pytest.raises(UndeliverableStreamRewrite):
+            await handler.process_output_streaming_response(
+                responses_so_far=events,
+                guardrail_to_apply=MaskToolCallArgumentsGuardrail(guardrail_name="mask"),
+                litellm_logging_obj=None,
+                deliver_ended_stream_rewrites=True,
+            )
+
+    @pytest.mark.asyncio
+    async def test_custom_tool_call_rewrite_left_untouched_by_default(self):
+        handler = OpenAIResponsesHandler()
+        events = self._ended_custom_stream_events()
+
+        await handler.process_output_streaming_response(
+            responses_so_far=events,
+            guardrail_to_apply=MaskToolCallArgumentsGuardrail(guardrail_name="mask"),
+            litellm_logging_obj=None,
+        )
+
+        assert events[1]["delta"] == "patch "
+        assert events[3]["input"] == "patch Secret"
+        assert events[5]["response"]["output"][0]["input"] == "patch Secret"
