+    def _apply_guardrail_responses_to_output_tool_calls(
+        self,
+        response: Union["ResponsesAPIResponse", ResponseOutputEnvelope],
+        tool_calls_to_check: Sequence[ChatCompletionToolCallChunk],
+        returned_tool_calls: object,
+        guardrail_name: str,
+    ) -> None:
+        """Write a guardrail's returned tool calls back onto the response output items.
+
+        The guardrail sees the scanned tool calls in order, so its returned calls
+        are matched positionally. Function calls get ``arguments`` and
+        custom/freeform calls get ``input``, and each item keeps its own
+        type/class. A tool call's ``name`` is only written when it changed, so a
+        custom tool call that had no name stays without one. A count mismatch --
+        including malformed entries that cannot be attributed -- leaves the
+        output unchanged and is logged, so a rewrite never lands on the wrong item.
+        """
+        # Handle both dict and Pydantic object responses
+        response_output: Final[Sequence[object]]
+        if isinstance(response, dict):
+            response_output = response.get("output", [])
+        elif hasattr(response, "output"):
+            response_output = response.output or []
+        else:
+            return
+
+        guardrailed_tool_calls: Final = _guardrail_tool_call_shapes(returned_tool_calls)
+        if len(guardrailed_tool_calls) != len(tool_calls_to_check):
+            verbose_proxy_logger.warning(
+                "OpenAI Responses API: guardrail %s returned %d tool calls for the %d scanned; leaving output unchanged",
+                guardrail_name,
+                len(guardrailed_tool_calls),
+                len(tool_calls_to_check),
+            )
+            return
+
+        for tool_call, guardrailed in zip(tool_calls_to_check, guardrailed_tool_calls):
+            output_idx: Final = tool_call.get("index")
+            if not isinstance(output_idx, int) or not (0 <= output_idx < len(response_output)):
+                continue
+            output_item: Final = response_output[output_idx]
+            field: Final = _tool_call_payload_field(output_item)
+            if field is None:
+                continue
+            if guardrailed.name is not None and guardrailed.name != tool_call["function"].get("name"):
+                self._write_event_field(output_item, "name", guardrailed.name)
+            self._write_event_field(output_item, field, guardrailed.arguments)
+
